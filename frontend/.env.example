# Which data layer the UI starts on. The header switch overrides this per browser.
#   real  - talk to the Python API (python -m discovery_agent.api)
#   mock  - clearly-labelled demo data, no backend needed
VITE_API_MODE=real

# Where the Vite dev server proxies /api. Only used by `npm run dev`.
VITE_BACKEND_URL=http://127.0.0.1:8000
